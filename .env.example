# FlowOps Environment Configuration (Phase 1)
# Copy this file to .env and adjust variables as needed

DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=flowops-insecure-dev-key-change-in-production-f38b29f9c0174e
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL Required for FlowOps)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flowops_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration for React Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis & Celery Configuration (Phase 2)
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=2

# Job Payload Limits (in bytes, default: 512KB)
MAX_PAYLOAD_SIZE_BYTES=524288

